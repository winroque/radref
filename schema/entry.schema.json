{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "radref entry front matter",
  "type": "object",
  "required": ["id", "title", "type", "area", "modalities", "population", "source_version",
               "status", "verified_against", "sources", "last_reviewed"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "type": {"enum": ["classification", "scale", "reference-values", "guideline", "terminology"]},
    "area": {"enum": ["abdomen", "pelvis-obstetrics", "breast", "thyroid-neck", "chest", "neuro",
                      "vascular", "msk-spine", "pediatrics", "oncology", "general"]},
    "modalities": {"type": "array", "items": {"enum": ["US", "CT", "MRI", "MG", "XR", "PET", "NM"]}, "minItems": 1},
    "population": {"enum": ["adults", "children", "pregnant", "all"]},
    "source_version": {"type": "string"},
    "status": {"enum": ["draft", "verified"]},
    "verified_against": {"type": "string"},
    "verified_by": {"type": "string"},
    "verified_on": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "superseded_by": {"type": "string"},
    "related": {"type": "array", "items": {"type": "string"}},
    "last_reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
